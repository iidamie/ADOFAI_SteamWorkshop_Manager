<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SteamWorkshopManager</AssemblyName>
    <RootNamespace>SteamWorkshopManager</RootNamespace>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NuGetAudit>false</NuGetAudit>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);dependencies/**</DefaultItemExcludes>

    <StArrayArtifacts Condition="'$(StArrayArtifacts)' == ''">$(MSBuildThisFileDirectory)../StArray.ModManager-csharp/artifacts</StArrayArtifacts>
    <StArrayReferenceDir Condition="Exists('$(StArrayArtifacts)/StArray.ModManager.dll')">$(StArrayArtifacts)</StArrayReferenceDir>
    <StArrayReferenceDir Condition="'$(StArrayReferenceDir)' == ''">$(MSBuildThisFileDirectory)References</StArrayReferenceDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="SteamKit2" Version="3.4.0" />
    <PackageReference Include="SteamKitSDK" Version="0.9.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="StArray.ModManager">
      <HintPath>$(StArrayReferenceDir)/StArray.ModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ImGui.NET">
      <HintPath>$(StArrayReferenceDir)/ImGui.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
